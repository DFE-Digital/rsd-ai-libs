<Project>
  <!--
    Compatibility settings for the packages (not the test projects), following Microsoft's .NET library guidance:
    https://learn.microsoft.com/dotnet/standard/library-guidance/

    - Public API tracking: every public type and member is listed in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt next
      to the project, and the build fails if the code and the lists disagree, so any change to the public API is
      deliberate and visible in review. Add-ons rely only on core's public API, so this is what keeps them compatible.
    - Package validation: dotnet pack checks the package. After a package's first release, set
      PackageValidationBaselineVersion to its last released version, so pack fails on a breaking change that isn't a
      new major version.
    - Versions: AssemblyVersion changes only with the major version (major.0.0.0), so an add-on built against core 1.2
      loads with core 1.5 without binding problems. FileVersion and InformationalVersion carry the full version.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Undeclared or removed public API, and overloads that would make adding parameters later a breaking change. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0026;RS0027</WarningsAsErrors>
    <!-- Dependency floors stay low (Renovate doesn't raise them), so restore checks the whole dependency graph for known
         vulnerabilities and fails on high or critical ones; raise the affected floor when it does. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>

    <_ReleaseVersion>$(PackageVersion)</_ReleaseVersion>
    <_ReleaseVersion Condition="'$(_ReleaseVersion)' == ''">$(Version)</_ReleaseVersion>
    <_ReleaseVersion Condition="'$(_ReleaseVersion)' == ''">1.0.0</_ReleaseVersion>
    <_ReleaseNumbers>$([System.Text.RegularExpressions.Regex]::Match($(_ReleaseVersion), '^\d+(\.\d+){0,3}').Value)</_ReleaseNumbers>
    <AssemblyVersion>$(_ReleaseNumbers.Split('.')[0]).0.0.0</AssemblyVersion>
    <FileVersion>$(_ReleaseNumbers)</FileVersion>
    <InformationalVersion>$(_ReleaseVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    Add-ons and core: each add-on references core as a project, so they're developed and tested together. When packed
    (pack-template.yml passes -p:UseCorePackage=true) an add-on is built against the published core at its
    CoreMinimumVersion instead, so its package depends on "core >= CoreMinimumVersion" and is proven to work with it.
    An add-on is then released on its own, and apps upgrade core or the add-on separately.
  -->
  <PropertyGroup>
    <_CoreProject>$(MSBuildThisFileDirectory)GovUK.Dfe.AI.Agents\GovUK.Dfe.AI.Agents.csproj</_CoreProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseCorePackage)' == 'true' and '$(CoreMinimumVersion)' != ''">
    <ProjectReference Remove="$(_CoreProject)" />
    <PackageReference Include="GovUK.Dfe.AI.Agents" Version="$(CoreMinimumVersion)" />
  </ItemGroup>

  <!--
    A package packed with core restored as a project would depend on core at the add-on's own version, which may not
    exist. The check reads what restore resolved, which is what pack writes into the package's dependencies.
  -->
  <Target Name="RequireCorePackageReference" BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' != 'false' and Exists('$(ProjectAssetsFile)')">
    <PropertyGroup>
      <_CoreRestoredAsProject>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(ProjectAssetsFile)')), '"GovUK\.Dfe\.AI\.Agents/[^"]+"\s*:\s*\{\s*"type"\s*:\s*"project"'))</_CoreRestoredAsProject>
    </PropertyGroup>
    <Error Condition="'$(_CoreRestoredAsProject)' == 'true'"
           Text="$(MSBuildProjectName) must be packed against the published core: set CoreMinimumVersion in its .csproj to the lowest core version it needs, then build and pack with -p:UseCorePackage=true (pack-template.yml does)." />
  </Target>
</Project>
