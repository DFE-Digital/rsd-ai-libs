<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <Title>GovUK.Dfe.AI.Agents.Evaluation</Title>
    <Description>Answer scoring for GovUK.Dfe.AI.Agents: a Foundry judge model scores groundedness and relevance, live and in release gates.</Description>
    <Authors>DFE-Digital</Authors>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="GovUK.Dfe.AI.Agents.Evaluation.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The lowest core version this add-on needs: its package depends on core >= this. Set it after core's first
         release, and raise it only when the add-on starts using something newer from core. -->
    <CoreMinimumVersion>0.0.1-prerelease.170</CoreMinimumVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GovUK.Dfe.AI.Agents\GovUK.Dfe.AI.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.10.0" />
  </ItemGroup>

</Project>
