<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <PackageReadmeFile>readme.md</PackageReadmeFile>
	  <Title>GovUK.Dfe.AI.Agents</Title>
	  <Description>Run Azure AI Foundry agents from .NET: versions, parallel and sequential runs, fenced evidence, checked answers, cost and concurrency limits, and token telemetry. Add-ons: .Mcp, .AISearch, .Evaluation, .Guardrails.</Description>
	  <Authors>DFE-Digital</Authors>
	  <!-- The OpenAI SDK marks its Responses API experimental (OPENAI001). The library uses it internally to run agents;
	       its public API exposes AgentTool instead, so apps that use the package never see the warning. -->
	  <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

	  <ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="\" />
		<InternalsVisibleTo Include="GovUK.Dfe.AI.Agents.Tests" />
		<InternalsVisibleTo Include="GovUK.Dfe.AI.Agents.Mcp.Tests" />
		<InternalsVisibleTo Include="GovUK.Dfe.AI.Agents.AISearch.Tests" />
		<InternalsVisibleTo Include="GovUK.Dfe.AI.Agents.Evaluation.Tests" />
		<InternalsVisibleTo Include="GovUK.Dfe.AI.Agents.Guardrails.Tests" />
		<!-- NSubstitute builds its mocks of internal interfaces in this assembly. -->
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	  </ItemGroup>

	  <ItemGroup>
		<PackageReference Include="Azure.AI.Projects" Version="2.0.1" />
		<PackageReference Include="Azure.AI.Projects.Agents" Version="2.0.0" />
		<PackageReference Include="Azure.AI.Extensions.OpenAI" Version="2.0.0" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.30.0" />
		<!-- Lowest versions that work, so apps aren't forced to upgrade (Microsoft's library guidance). Azure.Core 1.60
		     requires Hosting.Abstractions >= 10.0.9, which needs Logging.Abstractions and DependencyInjection.Abstractions
		     >= 10.0.9 too; the rest only need 10.0.0. Raise one only when the code or a dependency needs it. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
	</ItemGroup>

	  <ItemGroup>
	    <None Update="readme.md">
	      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </None>
	  </ItemGroup>

</Project>
