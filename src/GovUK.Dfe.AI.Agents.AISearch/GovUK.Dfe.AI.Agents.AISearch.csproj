<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <Title>GovUK.Dfe.AI.Agents.AISearch</Title>
    <Description>Azure AI Search evidence for GovUK.Dfe.AI.Agents: per-index fields, relevance filtering and safe filters.</Description>
    <Authors>DFE-Digital</Authors>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="GovUK.Dfe.AI.Agents.AISearch.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The lowest core version this add-on needs: its package depends on core >= this. Set it after core's first
         release, and raise it only when the add-on starts using something newer from core. -->
    <CoreMinimumVersion>0.0.1-prerelease.170</CoreMinimumVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GovUK.Dfe.AI.Agents\GovUK.Dfe.AI.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Search.Documents" Version="12.0.0" />
  </ItemGroup>

</Project>
