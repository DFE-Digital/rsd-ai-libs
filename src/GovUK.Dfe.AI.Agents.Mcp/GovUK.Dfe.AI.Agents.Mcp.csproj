<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <Title>GovUK.Dfe.AI.Agents.Mcp</Title>
    <Description>Tools from your own MCP servers for GovUK.Dfe.AI.Agents: run in your app with your credential, deny by default, checked at startup.</Description>
    <Authors>DFE-Digital</Authors>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="GovUK.Dfe.AI.Agents.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Replace with <PackageReference Include="GovUK.Dfe.AI.Agents" Version="X.Y.Z" /> once core is on NuGet.org, then
         delete the RequireCorePackageReference target below. -->
    <ProjectReference Include="..\GovUK.Dfe.AI.Agents\GovUK.Dfe.AI.Agents.csproj" />
  </ItemGroup>

  <!-- Packed with a project reference, this package would depend on core at this package's own version, which may not
       exist. Stop packing, so a package nobody can restore is never published. -->
  <Target Name="RequireCorePackageReference" BeforeTargets="GenerateNuspec">
    <Error Condition="'@(ProjectReference-&gt;AnyHaveMetadataValue('Filename', 'GovUK.Dfe.AI.Agents'))' == 'true'" Text="$(MSBuildProjectName) can't be packed while it references GovUK.Dfe.AI.Agents as a project: its package would depend on a core version that may not exist. Publish core, then replace the ProjectReference with a pinned PackageReference." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

</Project>
